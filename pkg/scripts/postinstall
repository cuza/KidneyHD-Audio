#!/bin/sh
# Start the control daemon and make Core Audio load the new driver.
# Only for the running system; an install onto another volume takes effect when that volume boots.
[ "$3" = "/" ] || exit 0
launchctl bootstrap system /Library/LaunchDaemons/dev.cuza.kidneyhd-audiod.plist
killall -9 coreaudiod 2>/dev/null
exit 0
